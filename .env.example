# Film Room environment template. Copy to .env and fill in. Never commit .env.
# Every value here is a documented default or placeholder — no real secrets.

NODE_ENV=development
PORT=8080
API_BASE_PATH=/api/v1

# Session cookie signing — REQUIRED in production (>= 16 chars). Generate with:
#   openssl rand -hex 32
SESSION_SECRET=dev-only-change-me-please-32chars

# Canonical public HTTPS origin (used for cookie/signed-URL reasoning).
PUBLIC_BASE_URL=http://localhost:8080

# ---- External MediaMTX connection (ADR 0005) ----
# Private, server-side only. The Sources & Settings screen stores per-tenant
# overrides in the DB; these are bootstrap defaults.
MEDIAMTX_API_URL=
MEDIAMTX_PLAYBACK_URL=
MEDIAMTX_RECORDING_HTTP_BASE=
MEDIAMTX_HLS_PUBLIC_BASE=
MEDIAMTX_WEBRTC_PUBLIC_BASE=
MEDIAMTX_RTMP_HOST=
MEDIAMTX_RTMP_PORT=1935

# Derived media + temp roots (worker uses these).
MEDIA_ROOT=./data/media
TEMP_ROOT=./data/tmp

# ---- Worker (clip pipeline) ----
# Worker reads recording segments over HTTP from the external MediaMTX and
# writes validated MP4 angles + thumbnails to MEDIA_OUTPUT_DIR.
WORKER_ID=worker-1
WORKER_POLL_MS=1000
JOB_LEASE_MS=60000
MEDIAMTX_RECORDING_HTTP_BASE=http://127.0.0.1:9997
MEDIA_OUTPUT_DIR=./data/media
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_SEGMENT_BYTES=268435456

# Worker heartbeat staleness thresholds (Phase 7) — used by /health/ready to
# classify workers as live (< WORKER_STALE_MS) / stale / dead (> WORKER_DEAD_MS).
WORKER_STALE_MS=15000
WORKER_DEAD_MS=60000

# Play capture defaults (ms).
DEFAULT_PRE_ROLL_MS=18000
DEFAULT_POST_ROLL_MS=3000
RECORDING_SETTLE_MS=2000
MAX_JOB_ATTEMPTS=3

# SSRF allowlist: comma-separated hostnames the server may fetch even though
# they resolve to private/loopback addresses. Add your private MediaMTX host.
SSRF_ALLOW_HOSTS=

# Feature flag for the live system. Offline local-film viewer works regardless.
LIVE_FILMROOM_ENABLED=false

LOG_LEVEL=info

# Database. Required.
DATABASE_URL=postgres://filmroom:filmroom@localhost:5432/filmroom
