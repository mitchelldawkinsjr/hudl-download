# API image. Build context is the repo root (../ from infra/).
FROM node:20-bookworm-slim
WORKDIR /app
# Install only the server's deps. The repo root has its own package.json for
# E2E tooling; we install the server package specifically.
COPY server/package.json server/package-lock.json* ./server/
WORKDIR /app/server
RUN npm ci --omit=dev --no-audit --no-fund || npm install --omit=dev --no-audit --no-fund
WORKDIR /app
COPY server ./server
COPY db ./db
WORKDIR /app/server
ENV NODE_ENV=production
EXPOSE 8080
CMD ["npx", "tsx", "src/index.ts"]
