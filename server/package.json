{
  "name": "film-room-server",
  "version": "0.1.0",
  "private": true,
  "description": "Film Room API — Node 20 + TypeScript + Express. Auth, games, sources, plays, settings, jobs, events.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "node --test --test-concurrency=1 --import tsx tests/ssrf.test.ts tests/auth.test.ts tests/settings.test.ts tests/sources.test.ts tests/plays.test.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "tsx": "^4.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "typescript": "^5.5.0"
  }
}
